# Copy to .env for local dev. NEVER commit real values.
# The `flask` command loads .env from the folder you run it in (needs python-dotenv, which is in
# requirements-dev.txt). scripts/ and pytest do NOT read it. Restart Flask after editing.
# One KEY=value per line, no spaces around "=". On Vercel, set these in Project Settings -> Environment Variables.

# --- Database: Tiger Cloud (TimescaleDB) or any Postgres. Server-only secret (contains the password) ---
# Leave empty for local dev: the API falls back to an in-memory store persisted to .devdb.json.
# From Tiger Console copy the service's connection string (postgres://tsdbadmin:...@...:PORT/tsdb?sslmode=require).
# On Vercel use the TRANSACTION pooler string (database tsdb_transaction); for scripts/init_db.py use the direct one.
DATABASE_URL=

# --- Web Push (VAPID). Generate with:  python scripts/gen_vapid.py ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- APNs (token-based auth, .p8 key from the Apple Developer account) ---
APNS_KEY_ID=
APNS_TEAM_ID=
# Contents of the .p8 file. Newlines may be written as \n.
APNS_AUTH_KEY=
APNS_BUNDLE_ID=
# 1 = sandbox host (dev builds), 0 = production host (TestFlight / App Store)
APNS_USE_SANDBOX=1

# --- Gemini (optional): richer coaching profile, "ask about your habits", "describe your day" ---
# Leave empty and everything still works: the dashboard builds the same profile on-device with plain rules.
# Use a key from a project with BILLING ENABLED (paid tier): Google's terms say the free tier may use inputs
# to improve its products (with human review) and forbid sending personal or sensitive information.
# Only de-identified habit numbers are ever sent, after an in-app opt-in. Never images, never pain check-ins.
GEMINI_API_KEY=
# Optional model override (default gemini-3.8-flash)
GEMINI_MODEL=

# --- Dev only ---
# 1 enables POST /api/dev/seed. Leave unset/0 in any shared deployment.
ENABLE_DEV_ROUTES=1
