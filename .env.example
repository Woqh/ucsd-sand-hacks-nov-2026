# Copy to .env for local dev. NEVER commit real values.
# The `flask` command loads .env from the folder you run it in (needs python-dotenv, which is in
# requirements-dev.txt). scripts/ and pytest do NOT read it. Restart Flask after editing.
# One KEY=value per line, no spaces around "=". On Vercel, set these in Project Settings -> Environment Variables.

# --- Supabase (server only; service-role key must never reach the browser or the app) ---
# Leave both empty for local dev: the API falls back to an in-memory store persisted to .devdb.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push (VAPID). Generate with:  python scripts/gen_vapid.py ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- APNs (token-based auth, .p8 key from the Apple Developer account) ---
APNS_KEY_ID=
APNS_TEAM_ID=
# Contents of the .p8 file. Newlines may be written as \n.
APNS_AUTH_KEY=
APNS_BUNDLE_ID=
# 1 = sandbox host (dev builds), 0 = production host (TestFlight / App Store)
APNS_USE_SANDBOX=1

# --- Dev only ---
# 1 enables POST /api/dev/seed. Leave unset/0 in any shared deployment.
ENABLE_DEV_ROUTES=1
